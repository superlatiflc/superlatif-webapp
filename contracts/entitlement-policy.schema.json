{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.superlatif.id/schemas/entitlement-policy.schema.json",
  "title": "Superlatif Entitlement Policy",
  "description": "Versioned additive access policy aligned with Product Catalogue & Entitlement 1.0-RC2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "code", "version", "title", "validity", "claims", "attemptAllowance", "postExpiry", "stacking", "lifecycle"],
  "properties": {
    "schemaVersion": {"const": 2},
    "code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "minLength": 3, "maxLength": 80},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 3, "maxLength": 180},
    "description": {"type": ["string", "null"], "maxLength": 2000},
    "validity": {"$ref": "#/$defs/validity"},
    "claims": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/claim"}},
    "attemptAllowance": {"$ref": "#/$defs/attemptAllowance"},
    "postExpiry": {"$ref": "#/$defs/postExpiry"},
    "stacking": {"$ref": "#/$defs/stacking"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "metadata": {"type": "object", "additionalProperties": true, "default": {}}
  },
  "$defs": {
    "validity": {
      "type": "object", "additionalProperties": false, "required": ["mode", "timezone"],
      "properties": {
        "mode": {"type": "string", "enum": ["fixed_window", "duration_after_purchase", "duration_after_activation", "through_program_or_batch_end", "lifetime", "manual"]},
        "timezone": {"type": "string", "default": "Asia/Jakarta"}, "startsAt": {"type": ["string", "null"], "format": "date-time"}, "endsAt": {"type": ["string", "null"], "format": "date-time"},
        "durationDays": {"type": ["integer", "null"], "minimum": 1, "maximum": 3650}, "lifecycleTargetRef": {"type": ["string", "null"], "maxLength": 100}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "fixed_window"}}}, "then": {"required": ["startsAt", "endsAt"]}},
        {"if": {"properties": {"mode": {"enum": ["duration_after_purchase", "duration_after_activation"]}}}, "then": {"required": ["durationDays"]}},
        {"if": {"properties": {"mode": {"const": "through_program_or_batch_end"}}}, "then": {"required": ["lifecycleTargetRef"]}}
      ]
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["targetType", "targetRef", "actions", "includeDescendants"],
      "properties": {
        "targetType": {"type": "string", "enum": ["program", "program_track", "module", "resource", "live_session", "live_session_series", "exam_batch", "batch_collection", "community", "capability"]},
        "targetRef": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 2, "maxLength": 100}, "version": {"type": ["integer", "null"], "minimum": 1}}},
        "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["view", "consume", "download", "join", "start_attempt", "view_result", "view_explanation"]}},
        "includeDescendants": {"type": "boolean"},
        "availabilityOverride": {"type": ["object", "null"], "additionalProperties": false, "properties": {"startsAt": {"type": ["string", "null"], "format": "date-time"}, "endsAt": {"type": ["string", "null"], "format": "date-time"}}}
      }
    },
    "attemptAllowance": {
      "type": "object", "additionalProperties": false, "required": ["mode", "maxRankedAttempts", "maxPracticeAttempts", "rankingRuleSource"],
      "properties": {"mode": {"type": "string", "enum": ["inherit_batch", "per_batch"]}, "maxRankedAttempts": {"type": ["integer", "null"], "minimum": 1, "maximum": 100}, "maxPracticeAttempts": {"const": 0}, "cooldownSeconds": {"type": "integer", "minimum": 0, "maximum": 2592000, "default": 0}, "rankingRuleSource": {"const": "batch"}}
    },
    "postExpiry": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"type": "string", "enum": ["hide_all", "read_only_history", "retain_selected_resources", "retain_results_only"], "default": "read_only_history"}, "retainedTargetRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "default": []}}
    },
    "stacking": {
      "type": "object", "additionalProperties": false, "required": ["mode", "expiryResolution", "attemptResolution"],
      "properties": {"mode": {"const": "additive"}, "expiryResolution": {"const": "latest_supporting_grant"}, "attemptResolution": {"type": "string", "enum": ["sum_distinct_sources", "maximum_allowance", "batch_policy_only"]}, "dedupeKey": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["source", "target", "action", "policy_version"]}}}
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["refundAction", "expiryAction", "manualChangeRequiresReason", "retainAttemptHistory", "retainResultHistory", "retainRankingSnapshot"],
      "properties": {"refundAction": {"type": "string", "enum": ["revoke_source_grant", "suspend_source_grant", "manual_review"]}, "expiryAction": {"const": "expire_source_grant"}, "manualChangeRequiresReason": {"const": true}, "manualRevokeRequiresApproval": {"type": "boolean", "default": true}, "retainAttemptHistory": {"const": true}, "retainResultHistory": {"const": true}, "retainRankingSnapshot": {"const": true}}
    }
  }
}
