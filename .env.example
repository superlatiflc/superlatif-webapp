# Superlatif Web App — configuration contract only.
# Copy to a local untracked environment file. Never commit real credentials.

# Runtime
APP_ENV=development
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# Database and cache
DATABASE_URL=
DATABASE_READ_URL=
REDIS_URL=
DB_STATEMENT_TIMEOUT_MS=10000

# Object storage and signed delivery
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
ASSET_SIGNING_SECRET=
ASSET_URL_TTL_SECONDS=900

# Application authentication
SESSION_SIGNING_SECRET=
SESSION_ENCRYPTION_SECRET=
SESSION_TTL_SECONDS=43200
PASSWORD_RESET_TTL_SECONDS=1800

# WordPress/Sejoli bridge — production use requires OD-01 and OD-02 evidence
WP_BRIDGE_BASE_URL=
WP_BRIDGE_CLIENT_ID=
WP_BRIDGE_CLIENT_SECRET=
SEJOLI_WEBHOOK_SIGNING_SECRET=
SEJOLI_CHECKOUT_BASE_URL=
COMMERCE_RECONCILIATION_ENABLED=false

# Messaging providers
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
WHATSAPP_PROVIDER_BASE_URL=
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_SENDER_ID=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=superlatif-webapp
ERROR_TRACKING_DSN=
METRICS_EXPORTER_ENDPOINT=

# Security and abuse controls
PII_HASHING_SECRET=
AUDIT_LOG_SIGNING_SECRET=
RATE_LIMIT_ENABLED=true
# Required whenever RATE_LIMIT_ENABLED is on outside local/test: apps/web
# refuses to start rather than serving without abuse protection. Dedicated
# key - never reuse a session/auth secret, so rotating it only resets
# rate-limit counters. Min 16 chars.
RATE_LIMIT_HASH_SECRET=
DEVICE_LEASE_ENFORCEMENT=false

# Release controls — fail closed by default
FEATURE_COMMERCE_SYNC=false
FEATURE_LIVE_CLASS=false
FEATURE_QUESTION_IMPORT=false
FEATURE_EXAM_ENGINE=false
FEATURE_LEADERBOARD=false
FEATURE_NOTIFICATIONS=false
SKD_PRODUCTION_ACTIVATION=false
PRODUCTION_WRITES_ENABLED=false

# Test-only deterministic seed; never reuse as a production secret
TEST_FIXTURE_SEED=superlatif-synthetic-v1
